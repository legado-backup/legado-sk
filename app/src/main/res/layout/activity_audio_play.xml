<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.book.audio.AudioPlayActivity">

    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription,ImageContrastCheck" />

    <View
        android:id="@+id/vw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#90000000" />

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:themeMode="dark" />

    <io.legado.app.ui.widget.image.ImageButton
        android:id="@+id/iv_settings"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_audio_pill"
        android:contentDescription="@string/read_aloud_setting"
        android:padding="8dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_bar"
        app:tint="@color/md_white_1000"
        tools:ignore="ImageContrastCheck" />

    <io.legado.app.ui.widget.image.CircleImageView
        android:id="@+id/iv_cover"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:contentDescription="@string/img_cover"
        android:scaleType="centerCrop"
        app:civ_border_color="@color/accent"
        app:civ_border_width="2dp"
        app:layout_constraintBottom_toTopOf="@+id/play_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        tools:src="@drawable/image_rss_article" />

    <FrameLayout
        android:id="@+id/play_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_sub_title"
        app:layout_constraintTop_toBottomOf="@+id/iv_cover">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/listening_text_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:fillViewport="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="21dp"
            android:visibility="gone">

        <LinearLayout
            android:id="@+id/listening_text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="@color/md_white_1000"
        app:layout_constraintBottom_toTopOf="@+id/ll_player_progress" />

    <LinearLayout
        android:id="@+id/ll_player_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_play_menu">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <io.legado.app.ui.widget.image.ImageButton
                android:id="@+id/iv_rewind_15"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/selector_circle_btn_bg"
                android:contentDescription="@string/rewind_15_seconds"
                android:padding="7dp"
                android:src="@drawable/ic_replay_15"
                app:tint="@color/md_white_1000"
                tools:ignore="ImageContrastCheck" />

            <io.legado.app.lib.theme.view.ThemeSeekBar
                android:id="@+id/player_progress"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:progressBackgroundTint="@color/md_dark_secondary" />

            <io.legado.app.ui.widget.image.ImageButton
                android:id="@+id/iv_forward_15"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/selector_circle_btn_bg"
                android:contentDescription="@string/forward_15_seconds"
                android:padding="7dp"
                android:src="@drawable/ic_forward_15"
                app:tint="@color/md_white_1000"
                tools:ignore="ImageContrastCheck" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Space
                android:layout_width="36dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tv_dur_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/md_white_1000"
                android:textSize="10sp"
                tools:ignore="HardcodedText,RtlSymmetry,TextContrastCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_all_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/md_white_1000"
                android:textSize="10sp"
                tools:ignore="HardcodedText,TextContrastCheck" />

            <Space
                android:layout_width="36dp"
                android:layout_height="1dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_play_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 传输控制行：语速 / 上一章 / 播放暂停 / 下一章 / 音量增强。
             语速与音量增强是听书页最常见的两个设置，按作者要求放这一行而不是收进设置；
             两端留出对称位置，中间保持"传输三键"居中的原有语义。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <io.legado.app.ui.widget.image.ImageButton
                android:id="@+id/iv_speed_control"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/selector_circle_btn_bg"
                android:contentDescription="@string/speed_control"
                android:padding="6dp"
                android:src="@drawable/ic_speed_control"
                app:tint="@color/md_white_1000"
                tools:ignore="ImageContrastCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <io.legado.app.ui.widget.image.ImageButton
                android:id="@+id/iv_skip_previous"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/selector_circle_btn_bg"
                android:contentDescription="@string/skip_previous"
                android:padding="6dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/md_white_1000"
                tools:ignore="ImageContrastCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab_play_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:contentDescription="@string/audio_play"
                    android:src="@drawable/ic_play_24dp"
                    android:tint="@color/md_black_1000"
                    app:backgroundTint="@color/md_white_1000"
                    app:elevation="2dp"
                    app:fabSize="normal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:pressedTranslationZ="2dp"
                    tools:ignore="ImageContrastCheck" />

                <io.legado.app.lib.theme.view.ThemeProgressBar
                    android:id="@+id/progress_loading"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="invisible"
                    app:layout_constraintWidth="parent"
                    app:layout_constraintHeight="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <io.legado.app.ui.widget.image.ImageButton
                android:id="@+id/iv_skip_next"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/selector_circle_btn_bg"
                android:contentDescription="@string/skip_next"
                android:padding="6dp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/md_white_1000"
                tools:ignore="ImageContrastCheck" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 音量增强：开=固定 2 倍、关=不增强（仅两档，2 倍以上必然削波）。 -->
            <io.legado.app.ui.widget.image.ImageButton
                android:id="@+id/iv_volume_gain"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/selector_circle_btn_bg"
                android:contentDescription="@string/read_aloud_volume_gain"
                android:padding="6dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/md_white_1000"
                tools:ignore="ImageContrastCheck" />

        </LinearLayout>

        <!-- 功能胶囊栏：对齐 Rimchars FeaturePill（图标 + 文字，选中态高亮）。
             目录 / 定时 / 引擎 / 角色 四项，是本页的"设置都在这里"入口集合。
             语速与缓存原先占底部两个圆按钮，按作者选择移到本页设置（齿轮）内，
             底部只留四胶囊，避免功能重复与拥挤。 -->
        <LinearLayout
            android:id="@+id/ll_feature_pills"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_pill_chapter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_audio_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_chapter"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/chapter_list"
                    android:src="@drawable/ic_toc"
                    app:tint="@color/md_white_1000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/chapter_list"
                    android:textColor="@color/md_white_1000"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_pill_timer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_audio_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_timer"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/set_timer"
                    android:src="@drawable/ic_time_add_24dp"
                    app:tint="@color/md_white_1000" />

                <TextView
                    android:id="@+id/tv_pill_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/set_timer"
                    android:textColor="@color/md_white_1000"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_pill_engine"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_audio_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_pill_engine"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/speak_engine"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/md_white_1000" />

                <TextView
                    android:id="@+id/tv_pill_engine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/speak_engine"
                    android:textColor="@color/md_white_1000"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_pill_role"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_audio_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_pill_role"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/ai_multi_voice"
                    android:src="@drawable/ic_bottom_person_e"
                    app:tint="@color/md_white_1000" />

                <TextView
                    android:id="@+id/tv_pill_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/ai_multi_voice"
                    android:textColor="@color/md_white_1000"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
